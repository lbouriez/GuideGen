  console.log('   # Generate only Claude skills and agents');
  console.log('   claude-bootstrap claude\n');

  console.log('   # Force reconfigure AI provider');
  console.log('   claude-bootstrap setup --force-setup\n');

  printDivider();
  printInfo('For more information, see README.md or visit: https://github.com/your-repo/claude-bootstrap');
}

// Export functions for testing
export { runSetupWizard, runAnalysisOnly, runSuggestMode };

// Only parse CLI args when not in test environment
if (process.env.NODE_ENV !== 'test') {
  program.parse();
}
