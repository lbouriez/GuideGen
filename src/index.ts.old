#!/usr/bin/env node

/**
 * Claude Bootstrap CLI
 * Generate CLAUDE.md, guidelines, skills, and agents for any project
 */

import { Command } from 'commander';
import inquirer from 'inquirer';
import { resolve } from 'path';
import type { AnalysisDepth, WizardState } from './types';
import {
  runDiscoveryPhase,
  runAnalysisPhase,
  runExtractionPhase,
  runGenerationPhase,
  writeArtifacts,
  readExistingSetup,
  runSuggestPhase,
  formatSuggestionForApply,
  // New specialized workflows
  runGuidelinesGeneration,
  runIndexGeneration,
  runClaudeGeneration,
} from './core/workflows';
import { writeFileContent } from './tools/file-io';
import { join } from 'path';
import type { Suggestion } from './core/phases/suggest/prompts';
import {
  printHeader,
  printPhase,
  printError,
  printSuccess,
  printInfo,
  printWarning,
  printDivider,
} from './utils/display';

const program = new Command();

program
  .name('claude-bootstrap')
  .description(
    'Bootstrap Claude Code setup - generates CLAUDE.md, guidelines, skills, and agents'
  )
  .version('0.1.0');

program
  .command('setup')
  .description('Full setup wizard - analyze codebase and generate all artifacts')
  .argument('[path]', 'Path to the project to analyze', '../')
  .option('-d, --depth <depth>', 'Analysis depth: quick, standard, thorough', 'standard')
  .option('-y, --yes', 'Skip confirmation prompts')
  .option('--overwrite', 'Overwrite existing files')
  .option('--force-setup', 'Force re-run the AI provider setup')
  .option('--debug', 'Enable debug mode with verbose file analysis information')
  .action(async (path: string, options: { depth: string; yes: boolean; overwrite: boolean; forceSetup: boolean; debug: boolean }) => {
    await runSetupWizard(path, options.depth as AnalysisDepth, options.yes, options.overwrite, options.forceSetup, options.debug);
  });

program
  .command('analyze')
  .description('Analysis only - detect patterns without generating files')
  .argument('[path]', 'Path to the project to analyze', '../')
  .option('-d, --depth <depth>', 'Analysis depth: quick, standard, thorough', 'standard')
  .option('--force-setup', 'Force re-run the AI provider setup')
  .option('--debug', 'Enable debug mode with verbose file analysis information')
  .action(async (path: string, options: { depth: string; forceSetup: boolean; debug: boolean }) => {
    await runAnalysisOnly(path, options.depth as AnalysisDepth, options.forceSetup, options.debug);
  });

program
  .command('guidelines')
  .description('Generate guidelines only (CLAUDE.md and .guidelines/)')
  .argument('[path]', 'Path to the project to analyze', '../')
  .option('-d, --depth <depth>', 'Analysis depth: quick, standard, thorough', 'standard')
  .option('-y, --yes', 'Skip confirmation prompts')
  .option('--overwrite', 'Overwrite existing files')
  .option('--force-setup', 'Force re-run the AI provider setup')
  .option('--debug', 'Enable debug mode with verbose file analysis information')
  .action(async (path: string, options: { depth: string; yes: boolean; overwrite: boolean; forceSetup: boolean; debug: boolean }) => {
    await runGuidelinesGeneration(path, options.depth as AnalysisDepth, options.yes, options.overwrite, options.forceSetup, options.debug);
  });

program
  .command('index')
  .description('Generate/update index files for guidelines')
  .argument('[path]', 'Path to the project with existing .guidelines/', '../')
  .option('-y, --yes', 'Skip confirmation prompts')
  .option('--overwrite', 'Overwrite existing index files')
  .option('--force-setup', 'Force re-run the AI provider setup')
  .option('--debug', 'Enable debug mode with verbose file analysis information')
  .action(async (path: string, options: { yes: boolean; overwrite: boolean; forceSetup: boolean; debug: boolean }) => {
    await runIndexGeneration(path, options.yes, options.overwrite, options.forceSetup, options.debug);
  });

program
  .command('claude')
  .description('Generate Claude-specific files only (skills and agents)')
  .argument('[path]', 'Path to the project to analyze', '../')
  .option('-d, --depth <depth>', 'Analysis depth: quick, standard, thorough', 'standard')
  .option('-y, --yes', 'Skip confirmation prompts')
  .option('--overwrite', 'Overwrite existing files')
  .option('--force-setup', 'Force re-run the AI provider setup')
  .option('--debug', 'Enable debug mode with verbose file analysis information')
  .action(async (path: string, options: { depth: string; yes: boolean; overwrite: boolean; forceSetup: boolean; debug: boolean }) => {
    await runClaudeGeneration(path, options.depth as AnalysisDepth, options.yes, options.overwrite, options.forceSetup, options.debug);
  });

program
  .command('suggest')
  .description('Suggest improvements to existing Claude Code setup')
  .argument('[path]', 'Path to the project to analyze', '../')
  .option('-d, --depth <depth>', 'Analysis depth: quick, standard, thorough', 'standard')
  .option('--force-setup', 'Force re-run the AI provider setup')
  .option('--debug', 'Enable debug mode with verbose file analysis information')
  .action(async (path: string, options: { depth: string; forceSetup: boolean; debug: boolean }) => {
    await runSuggestMode(path, options.depth as AnalysisDepth, options.forceSetup, options.debug);
  });

program
  .command('help')
  .description('Show detailed help and usage information')
  .action(() => {
    showDetailedHelp();
  });

async function runSetupWizard(
  targetPath: string,
  depth: AnalysisDepth,
  skipConfirm: boolean,
  overwrite: boolean,
  forceSetup: boolean = false,
  debug: boolean = false
): Promise<void> {
  printHeader();
  const resolvedPath = resolve(targetPath);
  printInfo(`Target: ${resolvedPath}`);
  printInfo(`Depth: ${depth}`);
  printDivider();

  // Initialize AI provider first
  printInfo('Initializing AI provider...');
   const { ProviderManager } = await import('./providers/manager');
  const providerManager = ProviderManager.getInstance();

  if (forceSetup) {
    await providerManager.forceSetup();
  } else {
    await providerManager.getClient(depth);
  }

  printSuccess('AI provider ready');
  printDivider();

  const state: WizardState = {
    targetPath: resolvedPath,
    options: {
      mode: 'setup',
      targetPath: resolvedPath,
      depth,
      interactive: !skipConfirm,
    },
    userApprovals: {
      techProfile: false,
      patterns: false,
      rules: false,
      artifacts: false,
    },
  };

  try {
    // Phase 1: Discovery
    printPhase(1, 'Discovery');
    const discoveryResult = await runDiscoveryPhase(resolvedPath, depth);

    if (!discoveryResult.success || !discoveryResult.data) {
      printError(`Discovery failed: ${discoveryResult.error}`);
      process.exit(1);
    }

    state.techProfile = discoveryResult.data;

    if (!skipConfirm && discoveryResult.humanReviewRequired) {
      const { approved } = await inquirer.prompt([
        {
          type: 'confirm',
          name: 'approved',
          message: discoveryResult.reviewPrompt,
          default: true,
        },
      ]);

      if (!approved) {
        printWarning('Please adjust and re-run. Exiting.');
        process.exit(0);
      }
    }

    state.userApprovals.techProfile = true;

    // Phase 2: Analysis
    printPhase(2, 'Pattern Analysis');
    const analysisResult = await runAnalysisPhase(
      resolvedPath,
      state.techProfile,
      depth,
      debug
    );

    if (!analysisResult.success || !analysisResult.data) {
      printError(`Analysis failed: ${analysisResult.error}`);
      process.exit(1);
    }

    state.patternReport = analysisResult.data;

    if (!skipConfirm && analysisResult.humanReviewRequired) {
      const { approved } = await inquirer.prompt([
        {
          type: 'confirm',
          name: 'approved',
          message: analysisResult.reviewPrompt,
          default: true,
        },
      ]);

      if (!approved) {
        printWarning('Please adjust and re-run. Exiting.');
        process.exit(0);
      }
    }

    state.userApprovals.patterns = true;

    // Phase 3: Extraction
    printPhase(3, 'Rule Analysis');
    const extractionResult = await runExtractionPhase(
      resolvedPath,
      state.techProfile,
      state.patternReport,
      depth,
      debug
    );

    if (!extractionResult.success || !extractionResult.data) {
      printError(`Extraction failed: ${extractionResult.error}`);
      process.exit(1);
    }

    state.rulesReport = extractionResult.data.rules;
    state.workflows = extractionResult.data.workflows;

    if (!skipConfirm && extractionResult.humanReviewRequired) {
      const { approved } = await inquirer.prompt([
        {
          type: 'confirm',
          name: 'approved',
          message: extractionResult.reviewPrompt,
          default: true,
        },
      ]);

      if (!approved) {
        printWarning('Please adjust and re-run. Exiting.');
        process.exit(0);
      }
    }

    state.userApprovals.rules = true;

    // Phase 4: Generation
    printPhase(4, 'Guideline Generation');
    const generationResult = await runGenerationPhase(
      resolvedPath,
      {
        techProfile: state.techProfile,
        patternReport: state.patternReport,
        rulesReport: state.rulesReport,
        workflows: state.workflows,
      },
      depth,
      debug
    );

    if (!generationResult.success || !generationResult.data) {
      printError(`Generation failed: ${generationResult.error}`);
      process.exit(1);
    }

    state.artifacts = generationResult.data;

    if (!skipConfirm && generationResult.humanReviewRequired) {
      const { approved } = await inquirer.prompt([
        {
          type: 'confirm',
          name: 'approved',
          message: generationResult.reviewPrompt,
          default: true,
        },
      ]);

      if (!approved) {
        printWarning('Artifacts not written. Exiting.');
        process.exit(0);
      }
    }

    state.userApprovals.artifacts = true;

    // Write artifacts
    await writeArtifacts(resolvedPath, state.artifacts, overwrite);

    printDivider();
    printSuccess('Claude Code setup complete!');
    printInfo('Next steps:');
    printInfo('  1. Review generated files and adjust as needed');
    printInfo('  2. Test skills with /skillname in Claude Code');
    printInfo('  3. Re-run with "suggest" command to get improvement ideas');
  } catch (error) {
    printError(
      `Setup failed: ${error instanceof Error ? error.message : 'Unknown error'}`
    );
    process.exit(1);
  }
}

async function runAnalysisOnly(
  targetPath: string,
  depth: AnalysisDepth,
  forceSetup: boolean = false,
  debug: boolean = false
): Promise<void> {
  printHeader();
  const resolvedPath = resolve(targetPath);

  // Interactive depth selection if not specified meaningfully
  if (depth === 'standard' && !forceSetup) {
    const { selectDepth } = await inquirer.prompt([
      {
        type: 'confirm',
        name: 'selectDepth',
        message: 'Would you like to choose analysis depth interactively?',
        default: false,
      },
    ]);

    if (selectDepth) {
      const { chosenDepth } = await inquirer.prompt([
        {
          type: 'list',
          name: 'chosenDepth',
          message: 'Select analysis depth:',
          choices: [
            { name: 'Quick (Fast, basic patterns)', value: 'quick' },
            { name: 'Standard (Balanced, detailed analysis)', value: 'standard' },
            { name: 'Thorough (Slow, comprehensive analysis)', value: 'thorough' },
          ],
          default: 'standard',
        },
      ]);
      depth = chosenDepth;
    }
  }

  printInfo(`Target: ${resolvedPath}`);
  printInfo(`Depth: ${depth}`);
  printInfo('Mode: Analysis only (no files will be written)');
  printDivider();

  // Initialize AI provider first
  printInfo('Initializing AI provider...');
   const { ProviderManager } = await import('./providers/manager');
  const providerManager = ProviderManager.getInstance();

  if (forceSetup) {
    await providerManager.forceSetup();
  } else {
    await providerManager.getClient(depth);
  }

  printSuccess('AI provider ready');
  printDivider();

  try {
    // Phase 1: Discovery
    printPhase(1, 'Discovery');
    const discoveryResult = await runDiscoveryPhase(resolvedPath, depth, debug);

    if (!discoveryResult.success || !discoveryResult.data) {
      printError(`Discovery failed: ${discoveryResult.error}`);
      process.exit(1);
    }

    // Phase 2: Analysis
    printPhase(2, 'Pattern Analysis');
    const analysisResult = await runAnalysisPhase(
      resolvedPath,
      discoveryResult.data,
      depth,
      debug
    );

    if (!analysisResult.success || !analysisResult.data) {
      printError(`Analysis failed: ${analysisResult.error}`);
      process.exit(1);
    }

    // Phase 3: Extraction
    printPhase(3, 'Rule Analysis');
    const extractionResult = await runExtractionPhase(
      resolvedPath,
      discoveryResult.data,
      analysisResult.data,
      depth,
      debug
    );

    if (!extractionResult.success || !extractionResult.data) {
      printError(`Extraction failed: ${extractionResult.error}`);
      process.exit(1);
    }

    printDivider();
    printSuccess('Analysis complete!');
    printInfo('Run "setup" command to generate artifacts based on this analysis.');
  } catch (error) {
    printError(
      `Analysis failed: ${error instanceof Error ? error.message : 'Unknown error'}`
    );
    process.exit(1);
  }
}

async function runSuggestMode(
  targetPath: string,
  depth: AnalysisDepth,
  forceSetup: boolean = false,
  debug: boolean = false
): Promise<void> {
  printHeader();
  const resolvedPath = resolve(targetPath);
  printInfo(`Target: ${resolvedPath}`);
  printInfo(`Depth: ${depth}`);
  printInfo('Mode: Suggest improvements to existing setup');
  printDivider();

  // Initialize AI provider first
  printInfo('Initializing AI provider...');
   const { ProviderManager } = await import('./providers/manager');
  const providerManager = ProviderManager.getInstance();

  if (forceSetup) {
    await providerManager.forceSetup();
  } else {
    await providerManager.getClient(depth);
  }

  printSuccess('AI provider ready');
  printDivider();

  try {
    // Step 1: Read existing setup
    printPhase(1, 'Reading Existing Setup');
    const existingSetup = await readExistingSetup(resolvedPath);

    if (!existingSetup.hasExistingSetup) {
      printWarning('No existing Claude Code setup found.');
      printInfo('Run "setup" command to create initial setup first.');
      process.exit(0);
    }

    // Step 2: Run fresh analysis
    printPhase(2, 'Fresh Analysis');

    printInfo('Running discovery...');
    const discoveryResult = await runDiscoveryPhase(resolvedPath, depth, debug);
    if (!discoveryResult.success || !discoveryResult.data) {
      printError(`Discovery failed: ${discoveryResult.error}`);
      process.exit(1);
    }

    printInfo('Analyzing patterns...');
    const analysisResult = await runAnalysisPhase(
      resolvedPath,
      discoveryResult.data,
      depth,
      debug
    );
    if (!analysisResult.success || !analysisResult.data) {
      printError(`Analysis failed: ${analysisResult.error}`);
      process.exit(1);
    }

    printInfo('Analyzing existing rules...');
    const extractionResult = await runExtractionPhase(
      resolvedPath,
      discoveryResult.data,
      analysisResult.data,
      depth,
      debug
    );
    if (!extractionResult.success || !extractionResult.data) {
      printError(`Extraction failed: ${extractionResult.error}`);
      process.exit(1);
    }

    // Step 3: Compare and suggest
    printPhase(3, 'Generating Suggestions');
    const suggestResult = await runSuggestPhase(
      resolvedPath,
      existingSetup,
      {
        techProfile: discoveryResult.data,
        patternReport: analysisResult.data,
        rulesReport: extractionResult.data.rules,
        workflows: extractionResult.data.workflows,
      },
      depth
    );

    if (!suggestResult.success || !suggestResult.data) {
      printError(`Suggest failed: ${suggestResult.error}`);
      process.exit(1);
    }

    const report = suggestResult.data;

    if (report.suggestions.length === 0) {
      printDivider();
      printSuccess('No suggestions - your setup is up to date!');
      process.exit(0);
    }

    // Step 4: Interactive apply
    printDivider();

    const { action } = await inquirer.prompt([
      {
        type: 'list',
        name: 'action',
        message: 'What would you like to do?',
        choices: [
          { name: 'Apply all high priority suggestions', value: 'high' },
          { name: 'Apply all suggestions', value: 'all' },
          { name: 'Select individual suggestions', value: 'select' },
          { name: 'Export suggestions to file', value: 'export' },
          { name: 'Exit without applying', value: 'exit' },
        ],
      },
    ]);

    if (action === 'exit') {
      printInfo('Exiting without applying changes.');
      process.exit(0);
    }

    if (action === 'export') {
      const exportPath = join(resolvedPath, 'claude-suggestions.md');
      const exportContent = generateSuggestionsExport(report.suggestions, report.overallAssessment);
      await writeFileContent(exportPath, exportContent);
      printSuccess(`Suggestions exported to: ${exportPath}`);
      process.exit(0);
    }

    let suggestionsToApply: Suggestion[] = [];

    if (action === 'high') {
      suggestionsToApply = report.suggestions.filter((s) => s.priority === 'high');
    } else if (action === 'all') {
      suggestionsToApply = report.suggestions;
    } else if (action === 'select') {
      const { selected } = await inquirer.prompt([
        {
          type: 'checkbox',
          name: 'selected',
          message: 'Select suggestions to apply:',
          choices: report.suggestions.map((s, i) => ({
            name: `[${s.priority}] ${s.description}`,
            value: i,
            checked: s.priority === 'high',
          })),
        },
      ]);
      suggestionsToApply = selected.map((i: number) => report.suggestions[i]);
    }

    if (suggestionsToApply.length === 0) {
      printInfo('No suggestions selected.');
      process.exit(0);
    }

    // Apply suggestions
    printPhase(4, 'Applying Suggestions');

    for (const suggestion of suggestionsToApply) {
      if (suggestion.suggestedContent) {
        const filePath = join(resolvedPath, suggestion.fileToModify);
        await writeFileContent(filePath, suggestion.suggestedContent);
        printSuccess(`Applied: ${suggestion.description}`);
        printInfo(`  → ${suggestion.fileToModify}`);
      } else {
        printWarning(`Skipped (no content): ${suggestion.description}`);
        printInfo(`  Manual action needed: ${suggestion.suggestedChange}`);
      }
    }

    printDivider();
    printSuccess('Suggestions applied!');
    printInfo('Review the changes and adjust as needed.');
  } catch (error) {
    printError(
      `Suggest failed: ${error instanceof Error ? error.message : 'Unknown error'}`
    );
    process.exit(1);
  }
}

function generateSuggestionsExport(
  suggestions: Suggestion[],
  assessment: string
): string {
  const lines: string[] = [
    '# Claude Code Setup Suggestions',
    '',
    '## Overall Assessment',
    assessment,
    '',
    '## Suggestions',
    '',
  ];

  const highPriority = suggestions.filter((s) => s.priority === 'high');
  const mediumPriority = suggestions.filter((s) => s.priority === 'medium');
  const lowPriority = suggestions.filter((s) => s.priority === 'low');

  if (highPriority.length > 0) {
    lines.push('### High Priority', '');
    highPriority.forEach((s) => {
      lines.push(formatSuggestionForApply(s));
    });
  }

  if (mediumPriority.length > 0) {
    lines.push('### Medium Priority', '');
    mediumPriority.forEach((s) => {
      lines.push(formatSuggestionForApply(s));
    });
  }

  if (lowPriority.length > 0) {
    lines.push('### Low Priority', '');
    lowPriority.forEach((s) => {
      lines.push(formatSuggestionForApply(s));
    });
  }

  return lines.join('\n');
}

